// Cloudflare Workers configuration for plankmd.org.
// Cloudflare builds the site from this repository on every push
// (build command: `cd site && npm ci && npm run build`) and serves the
// result as static assets. See RELEASING.md.
{
  "name": "plankmd",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site/.vitepress/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Pull requests get a preview (`wrangler preview`), which needs this
  // block even when empty: the assets above apply to previews too.
  "previews": {}
}
