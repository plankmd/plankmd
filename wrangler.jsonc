// Cloudflare Workers configuration for plankmd.org.
// Cloudflare builds the site from this repository on every push
// (build command: `cd site && npm ci && npm run build`) and serves the
// result as static assets. See RELEASING.md.
{
  "name": "plankmd",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site/.vitepress/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Pull requests get a preview: Workers Builds runs `npx wrangler preview`
  // on other branches, which needs this block. Empty: a preview serves the
  // same assets with the same settings as the site.
  "previews": {}
}
